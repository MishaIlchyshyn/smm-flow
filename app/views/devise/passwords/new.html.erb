<div class="auth-page">
  <div class="auth-box">
    <div class="auth-card">
      <%= render "application/logo", url: root_path, css_class: "auth-brand" %>

      <h2 class="auth-heading">Forgot your password?</h2>
      <p class="auth-subtext">Enter your email and we'll send you reset instructions.</p>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-fields">
          <div class="auth-field">
            <%= f.label :email %>
            <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "auth-input" %>
          </div>

          <%= f.submit "Send me reset instructions", class: "auth-btn" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <p class="auth-back">
      <%= link_to "← Back to home", root_path %>
    </p>
  </div>
</div>
