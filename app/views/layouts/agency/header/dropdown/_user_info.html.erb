<button class="user-btn" type="button" data-action="click->dropdown#toggle">
  <div class="user-name">
    <b><%= current_user.full_name %></b>
    <span><%= current_user.role_for(current_agency).capitalize %></span>
  </div>
  <div class="avatar">
    <%= current_user.avatar %>
  </div>
  <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="m6 9 6 6 6-6"/>
  </svg>
</button>
