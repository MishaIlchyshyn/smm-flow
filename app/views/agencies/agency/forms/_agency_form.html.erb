<%= form_with model: current_agency, url: agency_path, method: :patch, class: "form-col" do |f| %>
  <label class="fld">
    <span>Name</span>
    <%= f.text_field :name %>
  </label>
  <label class="fld">
    <span>Timezone</span>
    <%= f.select :timezone,
                 ActiveSupport::TimeZone.all.map { |tz| [tz.name, tz.name] },
                 { prompt: "Select Timezone" } %>
  </label>
  <%= render "agencies/btns/save", f: %>
<% end %>
