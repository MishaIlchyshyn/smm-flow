<div class="page-head">
  <h1>Profile</h1>
</div>

<div class="card settings-card" data-controller="tabs">
  <div class="inner-tabs">
    <%= render "agencies/btns/tab", label: "Base Settings", param: "base_settings" %>
    <%= render "agencies/btns/tab", label: "Password Settings", param: "password" %>
  </div>

  <div class="settings-body">
    <div data-tabs-target="panel">
      <%= render "agencies/profile/forms/profile_form" %>
    </div>

    <div data-tabs-target="panel" hidden>
      <%= render "agencies/profile/forms/profile_password_form" %>
    </div>
  </div>
</div>
