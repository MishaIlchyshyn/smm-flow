<div class="card table-card">
  <% if clients.any? %>
    <div class="thead client-grid">
      <span>Kind</span>
      <span>Name</span>
      <span>Email</span>
      <span>Website</span>
      <span>Created At</span>
    </div>
    <% clients.each do |client| %>
      <%= link_to client_path(client, tab: 'details'), class: "trow client-grid clickable", data: { turbo_frame: "_top" } do %>
        <span>
          <span class="kind-tag" style="<%= kind_tag_style(client.kind) %>">
            <%= client.kind.humanize %>
          </span>
        </span>
        <span><%= client.name %></span>
        <span><%= client.email %></span>
        <span><%= client.website_url %></span>
        <span><%= l(client.created_at, format: :display) %></span>
      <% end %>
    <% end %>
  <% else %>
    <div class="empty-state">No clients yet. Add your first one!</div>
  <% end %>
</div>
