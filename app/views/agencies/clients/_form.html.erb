<%= form_with model: client, class: "form-grid" do |f| %>
  <% if local_assigns[:title] %>
    <h4 class="form-title"><%= title %></h4>
  <% end %>
  <label class="fld">
    <span>Name <b class="req">*</b></span>
    <%= f.text_field :name, placeholder: "e.g. Bloom Coffee" %>
  </label>
  <label class="fld">
    <span>Email</span>
    <%= f.email_field :email, placeholder: "name@example.com" %>
  </label>
  <label class="fld">
    <span>Website URL</span>
    <%= f.url_field :website_url, placeholder: "https://example.com" %>
  </label>
  <label class="fld">
    <span>Kind <b class="req">*</b></span>
    <%= f.select :kind,
          Client.kinds.keys.map { |k| [k.humanize, k] } %>
  </label>
  <label class="fld">
    <span>Notes</span>
    <%= f.text_area :notes, placeholder: "e.g. Referred by Bloom Bakery" %>
  </label>
  <%= render "agencies/btns/save", f:, cancel: local_assigns[:cancel] %>
<% end %>
