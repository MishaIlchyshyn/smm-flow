<div class="breadcrumb">
  <%= link_to "Clients", clients_path %>
  <span class="sep">/</span>
  <%= link_to @client.business_name, client_path(@client, tab: 'details') %>
  <span class="sep">/</span>
  <%= link_to "Projects", client_path(@client, tab: "projects") %>
  <span class="sep">/</span>
  <span class="cur"><%= @project.name %></span>
</div>

<div class="card settings-card">
  <div class="settings-body">
    <p class="convert-note">
      Positioning complete: <b><%= @project.positioning_complete? ? "YES" : "NO" %></b>
      <%= link_to "View", project_path(@project, tab: "brand_positioning"), class: "inline-link" %>
    </p>
    <%= render "form", project: @project %>
  </div>
</div>
