<%= form_with model: [@client, project], class: "form-grid" do |f| %>
  <label class="fld">
    <span>Name</span>
    <%= f.text_field :name %>
  </label>
  <label class="fld">
    <span>Status</span>
    <%= f.select :status,
          Project.statuses.keys.map { |s| [project_status_label(s), s] } %>
  </label>
  <label class="fld newrow">
    <span>Started At</span>
    <%= f.date_field :started_at %>
  </label>
  <label class="fld">
    <span>Ended At</span>
    <%= f.date_field :ended_at %>
  </label>
  <div class="save-row">
    <%= f.submit "Save", class: "btn-primary" %>
    <% if project.persisted? %>
      <%= link_to client_project_path(@client, project),
            data: { turbo_method: :delete, turbo_confirm: "Delete this project? This cannot be undone." },
            class: "btn-danger" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
          <path d="M4 7h16M10 11v6M14 11v6M5 7l1 13a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l1-13M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/>
        </svg>
        Delete Project
      <% end %>
    <% end %>
  </div>
<% end %>
