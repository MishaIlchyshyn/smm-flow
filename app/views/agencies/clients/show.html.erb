<div data-controller="tabs">
  <div class="breadcrumb">
    <%= link_to "Clients", clients_path %>
    <span class="sep">/</span>
    <%= link_to @client.business_name, client_path(@client, tab: 'details') %>
    <span class="sep">/</span>
    <span class="cur" data-tabs-target="label"></span>
  </div>

  <div class="card settings-card">
    <div class="inner-tabs">
      <%= render "agencies/btns/tab", param: "details", label: "Details" %>
      <%= render "agencies/btns/tab", param: "activities", label: "Activities" %>
      <%= render "agencies/btns/tab", param: "notes", label: "Notes" %>
      <%= render "agencies/btns/tab", param: "projects", label: "Projects" %>
      <%= link_to client_path(@client),
            data: { turbo_method: :delete, turbo_confirm: "Delete this client? This cannot be undone." },
            class: "tab-delete",
            title: "Delete client" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
          <path d="M4 7h16M10 11v6M14 11v6M5 7l1 13a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1l1-13M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3"/>
        </svg>
      <% end %>
    </div>

    <div class="settings-body">
      <div data-tabs-target="panel">
        <% if @client.converted_at %>
          <p class="convert-note">
            Customer since: <b><%= l(@client.converted_at, format: :display_slash) %></b>
          </p>
        <% end %>
        <%= render "form", client: @client %>
      </div>

      <div data-tabs-target="panel" hidden>
        <p class="empty-state">No activities yet.</p>
      </div>

      <div data-tabs-target="panel" hidden>
        <p class="empty-state">No notes yet.</p>
      </div>

      <div data-tabs-target="panel" hidden>
        <%= render "projects_tab", client: @client, projects: @projects %>
      </div>
    </div>
  </div>
</div>
