<div id="client_details" data-controller="client-details">
  <div class="breadcrumb">
    <%= link_to "Clients", clients_path %>
    <span class="sep">/</span>
    <span class="cur"><%= client.name %></span>
  </div>

  <div class="card settings-card" data-controller="tabs">
    <div class="inner-tabs">
      <%= render "agencies/btns/tab", param: "details", label: "Details" %>
    </div>

    <div data-tabs-target="panel">
      <div class="settings-body client-view" data-client-details-target="view">
        <div class="client-view-inner">
          <div class="client-head">
            <h1 class="client-name"><%= client.name %></h1>
            <%= kind_badge(client) %>
          </div>

          <% if client.email.present? || client.website_url.present? %>
            <div class="client-meta">
              <% if client.email.present? %>
                <span class="client-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2"/>
                    <path d="m3 7 9 6 9-6"/>
                  </svg>
                  <%= mail_to client.email, class: "text-link", title: client.email %>
                </span>
              <% end %>
              <% if client.website_url.present? %>
                <span class="client-meta-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"/>
                    <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
                  </svg>
                  <%= link_to website_label(client.website_url), website_href(client.website_url),
                        class: "text-link", title: client.website_url, target: "_blank", rel: "noopener" %>
                </span>
              <% end %>
            </div>
          <% end %>

          <div class="client-created">Created <%= l(client.created_at, format: :display_datetime) %></div>

          <% if client.notes.present? %>
            <div class="client-notes"><%= client.notes %></div>
          <% end %>

          <%= render "agencies/clients/form/actions", client: %>
        </div>
      </div>

      <div class="settings-body" data-client-details-target="form" hidden>
        <%= render "agencies/clients/form", client:, title: "Edit client", cancel_stimulus_action: "client-details#cancel" %>
      </div>
    </div>
  </div>
</div>
