<span class="toast-icon <%= kind %>">
  <svg viewBox="0 0 24 24"
       fill="none"
       stroke="currentColor"
       stroke-width="2.2"
       stroke-linecap="round"
       stroke-linejoin="round">
    <circle cx="12" cy="12" r="9"/>
    <% if kind == "error" %>
      <path d="M12 8v5M12 16h.01"/>
    <% else %>
      <path d="m8.5 12 2.5 2.5 4.5-5"/>
    <% end %>
  </svg>
</span>
