<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 px-8 py-10">
      <h2 class="text-2xl font-semibold text-gray-900 mb-8">Create your account</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="space-y-5">
          <div>
            <%= f.label :full_name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.text_field :full_name,
                placeholder: "Kevin Mac",
                class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
          </div>

          <div>
            <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.email_field :email,
                placeholder: "kevin@example.com",
                class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
              <%= f.password_field :password,
                  class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
            </div>

            <div>
              <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
              <%= f.password_field :password_confirmation,
                  class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
            </div>
          </div>

          <div class="border-t border-gray-100 pt-5">
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-4">Agency details</p>

            <div class="space-y-5">
              <div>
                <%= f.label :agency_name, "Agency Name", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
                <%= f.text_field :agency_name,
                    placeholder: "Test Agency",
                    class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
              </div>

              <div>
                <%= f.label :agency_timezone, "Agency Timezone", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
                <%= f.select :agency_timezone,
                             ActiveSupport::TimeZone.all.map { |tz| [tz.name, tz.name] },
                             { prompt: "Select Timezone" },
                             class: "block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-2.5 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition" %>
              </div>
            </div>
          </div>

          <%= f.submit "Create account",
              class: "mt-2 w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 active:bg-indigo-700 transition cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 space-y-1.5 text-sm text-gray-500">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-gray-500">
      <%= link_to "← Back to home", root_path, class: "text-indigo-600 hover:text-indigo-500 font-medium" %>
    </p>
  </div>
</div>
