<div class="auth-page">
  <div class="auth-box">
    <div class="auth-card">
      <%= render "application/logo", url: root_path, css_class: "auth-brand" %>

      <h2 class="auth-heading">Create your account</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-fields">
          <div class="auth-field">
            <%= f.label :first_name do %>First name <b class="req">*</b><% end %>
            <%= f.text_field :first_name,
                placeholder: "Jane",
                class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :last_name do %>Last name <b class="req">*</b><% end %>
            <%= f.text_field :last_name,
                placeholder: "Smith",
                class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :email do %>Email <b class="req">*</b><% end %>
            <%= f.email_field :email,
                placeholder: "jone_smith@example.com",
                class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :password do %>Password <b class="req">*</b><% end %>
            <%= f.password_field :password, class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :password_confirmation do %>Password confirmation <b class="req">*</b><% end %>
            <%= f.password_field :password_confirmation, class: "auth-input" %>
          </div>

          <%= f.submit "Create account", class: "auth-btn" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <p class="auth-back">
      <%= link_to "← Back to home", root_path %>
    </p>
  </div>
</div>
