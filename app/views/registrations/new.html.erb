<div class="auth-page">
  <div class="auth-box auth-box--wide">
    <div class="auth-card">
      <%= render "application/logo", url: root_path, css_class: "auth-brand" %>

      <h2 class="auth-heading">Create your account</h2>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="auth-fields">
          <div class="auth-field">
            <%= f.label :full_name %>
            <%= f.text_field :full_name,
                placeholder: "Jane Smith",
                class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :email %>
            <%= f.email_field :email,
                placeholder: "jone_smith@example.com",
                class: "auth-input" %>
          </div>

          <div class="auth-cols">
            <div class="auth-field">
              <%= f.label :password %>
              <%= f.password_field :password, class: "auth-input" %>
            </div>

            <div class="auth-field">
              <%= f.label :password_confirmation %>
              <%= f.password_field :password_confirmation, class: "auth-input" %>
            </div>
          </div>

          <hr class="auth-divider">

          <p class="auth-section-label">Agency details</p>

          <div class="auth-field">
            <%= f.label :agency_name, "Agency Name" %>
            <%= f.text_field :agency_name,
                placeholder: "Acme Marketing",
                class: "auth-input" %>
          </div>

          <div class="auth-field">
            <%= f.label :agency_timezone, "Agency Timezone" %>
            <%= f.select :agency_timezone,
                         ActiveSupport::TimeZone.all.map { |tz| [tz.name, tz.name] },
                         { prompt: "Select Timezone" },
                         class: "auth-input" %>
          </div>

          <%= f.submit "Create account", class: "auth-btn" %>
        </div>
      <% end %>

      <div class="auth-links">
        <%= render "devise/shared/links" %>
      </div>
    </div>

    <p class="auth-back">
      <%= link_to "← Back to home", root_path %>
    </p>
  </div>
</div>
